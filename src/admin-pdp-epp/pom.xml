<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>gov.nist.csd.pm.pdp</groupId>
        <artifactId>parent</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>
    <artifactId>admin-pdp-epp</artifactId>
    <version>1.0-SNAPSHOT</version>

    <!--
        This module compiles against and embeds org.neo4j:neo4j (GPLv3, Community
        Edition). As a combined work, it is distributed under the GNU General Public
        License v3.0, not the CC BY 4.0 license used elsewhere in this repository.
        See ./LICENSE for the full text.
    -->
    <licenses>
        <license>
            <name>GNU General Public License v3.0</name>
            <url>https://www.gnu.org/licenses/gpl-3.0.en.html</url>
            <distribution>repo</distribution>
            <comments>See LICENSE in this module's directory.</comments>
        </license>
    </licenses>

    <properties>
        <main.class>gov.nist.csd.pm.pdp.admin.AdminPDPEPPApplication</main.class>
    </properties>

    <dependencies>
        <dependency>
            <groupId>gov.nist.csd.pm.pdp</groupId>
            <artifactId>shared</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>gov.nist.csd.pm.pdp</groupId>
            <artifactId>shared-test</artifactId>
            <version>1.0-SNAPSHOT</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>gov.nist.ngac.pm</groupId>
            <artifactId>policy-machine-core-neo4j</artifactId>
            <version>${policy-machine-core.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>21</source>
                    <target>21</target>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>